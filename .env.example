# NVIDIA API key — create free at https://build.nvidia.com
NVIDIA_API_KEY=

# GroundX API key — from https://dashboard.groundx.ai
GROUNDX_API_KEY=

# Optional overrides
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GROUNDX_BUCKET=nvidia-quickstart-demo

# Self-hosted GroundX only (Scenario B): your instance's API address.
# Leave unset to use GroundX cloud.
# GROUNDX_BASE_URL=http://your-machine:8080/api
