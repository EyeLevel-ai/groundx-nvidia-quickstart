# NVIDIA API key — create free at https://build.nvidia.com
NVIDIA_API_KEY=

# GroundX API key — from https://dashboard.groundx.ai
GROUNDX_API_KEY=

# Optional overrides
GROUNDX_BUCKET=nvidia-quickstart-demo
# Model used for document processing — must be vision-capable
NVIDIA_INGEST_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# Self-hosted GroundX only (Scenario B): your instance's API address, and set
# GROUNDX_API_KEY above to admin.apiKey from deploy/values-single-node.yaml.
# Leave unset to use GroundX cloud. (Running the scripts from another machine?
# Replace localhost with the GPU machine's address — see deploy/README "Use it".)
# GROUNDX_BASE_URL=http://localhost:8080/api
